# Medusa Configuration Example
# Copy this file to .env and modify values as needed

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@postgres:5432/medusa-docker?sslmode=prefer

# Redis Configuration  
REDIS_URL=redis://redis:6379

# Server Configuration
NODE_ENV=development
NPM_CONFIG_UPDATE_NOTIFIER=false
NODE_TLS_REJECT_UNAUTHORIZED=0

# Admin/Store CORS (modify for production)
STORE_CORS=http://localhost:8000,http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:9001
AUTH_CORS=http://localhost:9000,http://localhost:9001

# Security (change in production!)
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret